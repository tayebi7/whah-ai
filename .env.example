# Copy to .env.local. NEVER commit real keys. Everything is optional.
# AI providers are normally added in the app: Settings -> Add provider.

# Protects /api/* with a shared token (sent as x-waha-token). Strongly recommended
# for any internet-facing deployment. Generate: openssl rand -hex 32
WAHA_ACCESS_TOKEN=

# Key that encrypts provider API keys at rest (AES-256-GCM). If empty, a key file
# (.secret-key) is created inside WAHA_DATA_DIR. Back it up: without it, saved keys are unreadable.
WAHA_ENCRYPTION_KEY=

# Where providers, files, jobs and generated assets are stored (default ./data).
WAHA_DATA_DIR=./data

# Allow local endpoints such as Ollama / LM Studio (http://localhost:...). Keep false on public servers.
WAHA_ALLOW_LOCAL=false

WAHA_MAX_UPLOAD_MB=25
WAHA_MAX_GENERATED_MB=200
WAHA_RETENTION_DAYS=30

# Optional font file for burned-in video captions (needed for Arabic captions if the system has none).
WAHA_FONT_FILE=

# Optional read-only providers declared in env (JSON array on ONE line). Providers added in the UI win on id clash.
# WAHA_PROVIDERS=[{"id":"openai","name":"OpenAI","baseUrl":"https://api.openai.com/v1","apiKey":"REPLACE_ME","model":"gpt-4o-mini","priority":1}]
